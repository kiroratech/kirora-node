{
  "name": "@kirora/node",
  "version": "0.1.0",
  "description": "Kirora SDK for Node.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiroratech/node-sdk.git"
  },
  "homepage": "https://github.com/kiroratech/node-sdk#readme",
  "bugs": {
    "url": "https://github.com/kiroratech/node-sdk/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "check:package": "node scripts/check-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@8.6.0"
}
